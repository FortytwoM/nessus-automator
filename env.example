# Required
NESSUS_USERNAME=admin
NESSUS_PASSWORD=changeme

# Gateway
GATEWAY_BIND_IP=127.0.0.1
GATEWAY_CERT_DIR=./certs
# GATEWAY_ALLOWED_CIDRS=10.20.30.0/24,192.0.2.10/32

# Docker Desktop publishes https://127.0.0.1:8834 through docker-compose.desktop.yml.
# nessusctl and the maintenance scripts attach that overlay automatically.
# For a raw docker compose command:
#   docker compose -f docker-compose.yml -f docker-compose.desktop.yml up -d
# NESSUS_COMPOSE_DESKTOP=1

# Choose one plugin source

# Online
# NESSUS_PROFILE=online
# NESSUS_UPDATE_URL=https://plugins.nessus.org/v2/nessus.php?f=all-2.0.tar.gz&u=...&p=...
# NESSUS_UPDATE_SHA256=...
# Nessus 10.12+ requires a detached signature. For the URL source it is
# downloaded automatically (all-2.0.tar.gz.sig). For a local archive, place
# <archive>.sig next to it.

# Offline: place the .deb and all-2.0.tar.gz in packages/
# NESSUS_PROFILE=offline
# NESSUS_PLUGIN_SET=202609100156

# Optional installer override
# NESSUS_DEB_PATH=/mnt/nessus/Nessus-10.12.0-debian10_amd64.deb
# NESSUS_DEB_URL=https://downloads.tenable.com/...
# NESSUS_DEB_SHA256=...
# NESSUS_DEB_INSTALL=local

# Scan source on a multi-homed Linux host
# NESSUS_SOURCE_IP=195.239.191.99
# NESSUS_ROUTE_PROBE_IP=8.8.8.8

# Container DNS resolver
# NESSUS_DNS_SERVERS=10.10.0.53,10.10.0.54
# NESSUS_DNS_SEARCH=corp.example.internal

# Update coordination
# NESSUS_UPDATE_WAIT_FOR_SCANS=14400
# NESSUS_UPDATE_SCAN_POLL_INTERVAL=10
# NESSUS_UPDATE_SCAN_GRACE_SEC=3
# NESSUS_UPDATE_SKIP_SCAN_CHECK=0

# Scheduled updates (disabled until a UTC window is set)
# NESSUS_UPDATE_WINDOW_UTC=02:00-05:00
# NESSUS_UPDATE_MAX_FEED_AGE_HOURS=48
# NESSUS_UPDATE_RETRY_INITIAL_SECONDS=300
# NESSUS_UPDATE_RETRY_MAX_SECONDS=3600
# Seconds to wait for plugin rollback after cancelling an update
# NESSUS_UPDATE_CANCEL_WAIT_SECONDS=180

# Automatic plugin rollback
# NESSUS_UPDATE_ROLLBACK=1
# NESSUS_UPDATE_ROLLBACK_KEEP=2
# NESSUS_UPDATE_ROLLBACK_MAX_BYTES=5368709120

# Download and upload limits
# NESSUS_DOWNLOAD_MAX_BYTES=1073741824
# NESSUS_MANAGE_MAX_UPLOAD_BYTES=1073741824
# NESSUS_MANAGE_MAX_SIGNATURE_BYTES=1048576
# NESSUS_DOWNLOAD_FS_SIZE=2300m
# NESSUS_DOWNLOAD_TIMEOUT=1800
# NESSUS_DOWNLOAD_ALLOWED_SCHEMES=https
# NESSUS_DOWNLOAD_ALLOWED_HOSTS=plugins.nessus.org,*.tenable.com
# NESSUS_DOWNLOAD_ALLOWED_PORTS=443

# Readiness
# NESSUS_READY_TIMEOUT=1800
# NESSUS_READY_RETRY_TIMEOUT=600
# NESSUS_HEALTH_START_PERIOD=1800
# NESSUS_HEALTH_STRICT=1

# Proxy
# NESSUS_PROXY=http://proxy.example.com:8080

# Advanced
# NESSUS_BACKEND_PORT=8835
# NESSUS_LISTEN_ADDRESS=127.0.0.1
# NESSUS_MANAGE_BIND=127.0.0.1
# NESSUS_MANAGE_PORT=8080
# NESSUS_UPDATE_FILE=/mnt/nessus/all-2.0.tar.gz
# NESSUS_UPDATE_HOLD_FILE=/opt/nessus/var/nessus/.update_hold
# NESSUS_MANAGE_LOG_HEALTH=1
