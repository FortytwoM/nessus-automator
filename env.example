# =============================================================================
# Nessus Docker — copy to .env and adjust
#   cp env.example .env
#
# Pick ONE plugin source block (online OR offline), not both.
# =============================================================================

# --- CORE (always) -----------------------------------------------------------
NESSUS_USERNAME=admin
NESSUS_PASSWORD=changeme
# NESSUS_ALLOW_DEFAULT_PASSWORD=0   # set 1 only for disposable lab with weak password

# =============================================================================
# OPTION A — ONLINE (download feed on POST /manage/v1/update)
# =============================================================================
# Credentials: https://plugins.nessus.org/offline.php → u= and p= in URL
# plugin_set for patch: fetched automatically from https://plugins.nessus.org/v2/plugins.php
# NESSUS_PROFILE=online
# NESSUS_UPDATE_URL=https://plugins.nessus.org/v2/nessus.php?f=all-2.0.tar.gz&u=...&p=...

# =============================================================================
# OPTION B — OFFLINE (feed in ./packages/, no internet on update)
# =============================================================================
# NESSUS_PROFILE=offline
# Put all-2.0.tar.gz in packages/ and set plugin set id (12 digits, from offline.php):
# NESSUS_PLUGIN_SET=202606300622

# Update source priority (API and update.sh):
#   1. archive in POST body (path or multipart upload) + plugin_set required
#   2. NESSUS_UPDATE_FILE or packages/all-2.0.tar.gz + NESSUS_PLUGIN_SET required
#   3. NESSUS_UPDATE_URL (online; plugin_set from plugins.php)

# --- UPDATES: operator-only (POST /manage/v1/update) -------------------------
# NESSUS_UPDATE_WAIT_FOR_SCANS=14400
# NESSUS_UPDATE_SCAN_POLL_INTERVAL=10
# NESSUS_UPDATE_SCAN_GRACE_SEC=3
# NESSUS_UPDATE_HOLD_FILE=/mnt/nessus/.update_hold

# --- Operator API uploads (multipart offline delivery) -----------------------
# NESSUS_MANAGE_UPLOAD_DIR=/opt/nessus/var/nessus/incoming
# NESSUS_MANAGE_LOG_HEALTH=1
# NESSUS_MANAGE_MAX_UPLOAD_BYTES=2147483648

# --- STARTUP: plugin compile / Docker health (seconds) ------------------------
# NESSUS_READY_TIMEOUT=1800
# NESSUS_READY_RETRY_TIMEOUT=600
# NESSUS_HEALTH_START_PERIOD=1800

# --- INSTALL (optional local .deb in packages/) ------------------------------
# NESSUS_DEB_PATH=/mnt/nessus/Nessus-10.12.0-debian10_amd64.deb
# NESSUS_DEB_URL=https://...

# --- TLS (optional) ----------------------------------------------------------
# NESSUS_CERT_SAN=192.168.1.103,nessus.local
# GATEWAY_CERT_SAN=localhost,127.0.0.1,192.168.1.103

# --- PROXY (optional, online download) ---------------------------------------
# NESSUS_PROXY=http://proxy.example.com:8080

# =============================================================================
# ADVANCED
# =============================================================================
# NESSUS_UPDATE_FILE=/mnt/nessus/all-2.0.tar.gz
# NESSUS_UPDATE_SKIP_SCAN_CHECK=0
# NESSUS_HTTP_PROXY=  NESSUS_HTTPS_PROXY=  NESSUS_ALL_PROXY=  NESSUS_NO_PROXY=
